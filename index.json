                    "cotester_chat_messages": [
                        {
                            "id": "1301",
                            "tc_id": "784",
                            "thread_id": "",
                            "user_id": "41",
                            "message": "User opens the CURA Healthcare application.\nUser taps on the Make Appointment button.\nWait until the Username field is visible.\nUser enters username: John Doe.\nWait until the Password field is visible.\nUser enters password: ThisIsNotAPassword.\nUser taps on the Login button.\nWait until the Appointment Booking page is displayed.\nUser selects Hongkong CURA Healthcare Center from the Facility dropdown.\nUser selects Medicaid as the healthcare program.\nUser selects a future visit date.\nUser enters the comment: \"I have very high fever.\"\nUser reviews the appointment details.\nUser taps on the Book Appointment button.\nWait until the Appointment Confirmation page is displayed.\nUser verifies the appointment details:\nHealthcare Facility: Hongkong CURA Healthcare Center\nHealthcare Program: Medicaid\nVisit Date: Selected Future Date\nComment: I have very high fever\nUser confirms that all displayed appointment information is correct.\nAppointment booking process is completed successfully.",
                            "message_type": "sender",
                            "created_at": "2026-07-08 15:15:40",
                            "updated_at": "2026-07-08 15:15:40"
                        },
                        {
                            "id": "1302",
                            "tc_id": "784",
                            "thread_id": "",
                            "user_id": "41",
                            "message": "Test Case: 1\n\nTest Case Title: Successful Appointment Booking with Hongkong CURA Healthcare Center and Medicaid\nModule: Appointment Booking\nPriority: High\n\nPreconditions:\n- User has access to the CURA Healthcare application.\n- User is on the application home screen.\n- \"John Doe\" is a registered user with valid credentials.\n\nTest Steps:\n1. Tap on the Make Appointment button on the home screen.\n2. Wait until the Username field is visible.\n3. Enter \"John Doe\" in the Username field.\n4. Wait until the Password field is visible.\n5. Enter \"ThisIsNotAPassword\" in the Password field.\n6. Tap on the Login button.\n7. Wait until the Appointment Booking page is displayed.\n8. Select \"Hongkong CURA Healthcare Center\" from the Facility dropdown.\n9. Select \"Medicaid\" as the healthcare program.\n10. Select a future date from the Visit Date selector.\n11. Enter \"I have very high fever.\" in the Comment field.\n12. Review the appointment details.\n13. Tap on the Book Appointment button.\n14. Wait until the Appointment Confirmation page is displayed.\n15. Verify that the appointment confirmation displays:\n    - Healthcare Facility: Hongkong CURA Healthcare Center\n    - Healthcare Program: Medicaid\n    - Visit Date: Matches the previously selected future date\n    - Comment: I have very high fever\n\nExpected Result:\n- The user is directed to the Appointment Booking page after a successful login.\n- The selected Facility, Healthcare Program, Visit Date, and Comment fields display the correct values on the Confirmation page.\n- The Appointment Confirmation page confirms the booking and shows all submitted details accurately.\n- The appointment booking process completes successfully with a confirmation message.",
                            "message_type": "replier",
                            "created_at": "2026-07-08 15:15:49",
                            "updated_at": "2026-07-08 15:15:49"
                        }
                    ]
                }
